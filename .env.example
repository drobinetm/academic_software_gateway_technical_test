ENVIRONMENT=local
INNOVASOFT_BASE_URL=https://pruebareactjs.test-class.com/Api/

# Local development: use Docker (docker-compose up -d)
# Production (Vercel): use MongoDB Atlas connection string
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=innovasoft_proxy
API_TIMEOUT_SECONDS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

# Catch-all proxy / OpenAPI / request log settings
UPSTREAM_OPENAPI_URL=https://pruebareactjs.test-class.com/Api/swagger/v1/swagger.json
UPSTREAM_OPENAPI_FETCH_TIMEOUT=10
OPENAPI_CACHE_PATH=static/innovasoft_openapi_cache.json
REQUEST_LOGS_COLLECTION=request_logs
REQUEST_LOG_TTL_SECONDS=